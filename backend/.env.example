PORT=3001

# Banco de dados de produção
DB_HOST=seu-host-mysql
DB_PORT=3306
DB_USER=seu-usuario
DB_PASSWORD=sua-senha
DB_NAME=licitacao_kanban

# Segredo longo e aleatório para assinar os tokens JWT
JWT_SECRET=gere-um-segredo-longo-e-aleatorio

# Uma ou mais origens separadas por vírgula
# Exemplo: https://seu-site.com,https://www.seu-site.com
FRONTEND_URL=https://seu-site.com
