PORT=3001

# Banco de dados de produção
DB_HOST=seu-host-mysql
DB_PORT=3306
DB_USER=seu-usuario
DB_PASSWORD=sua-senha
DB_NAME=licitacao_kanban

# Certificado CA do banco (no Aiven: Overview > CA Certificate). Obrigatório no Aiven; sem ele o backend não sobe.
# Não é segredo, mas é específico do projeto. Banco local não precisa.
# Em painéis como o do Render, cole o conteúdo do ca.pem no valor da variável. Num arquivo .env, use aspas:
# DB_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Obrigatório: segredo aleatório com pelo menos 32 caracteres
# Exemplo de geração: openssl rand -base64 48
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Uma ou mais origens separadas por vírgula
# Exemplo: https://seu-site.com,https://www.seu-site.com
FRONTEND_URL=https://seu-site.com

# Segredo que a Vercel envia em cada chamada repassada (frontend/vercel.json). Só com ele o backend aceita
# o IP do visitante informado pela Vercel. Use o MESMO valor na Vercel e no Render. Banco local não precisa.
# Geração: openssl rand -hex 32
# ORIGIN_SECRET=

# Testes automáticos (npm test): os que gravam dados usam SÓ este banco separado, nunca o DB_NAME.
# O nome precisa terminar em _test. Sem esta variável (ou em produção), esses testes são pulados.
# Criação, uma vez só (como root do MySQL):
#   sudo mysql -e "CREATE DATABASE licitacao_kanban_test; GRANT ALL PRIVILEGES ON licitacao_kanban_test.* TO 'licit'@'localhost';"
# Não defina TEST_DB_NAME no servidor de produção (Render).
# TEST_DB_NAME=licitacao_kanban_test
